includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
    tmpDir: /tmp/phpstan

    # Model properties are populated via Eloquent magic; ignore common noise.
    ignoreErrors:
        - message: '#Class App\\Models\\.* uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types#'
          paths:
            - app/Models/*.php
        - message: '#Access to an undefined property#'
          paths:
            - app/Support/TreeEditor.php
        - message: '#Call to an undefined method#'
          paths:
            - app/Support/TreeEditor.php

    excludePaths:
        - app/Providers/RouteServiceProvider.php (?)
